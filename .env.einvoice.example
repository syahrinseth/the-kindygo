# LHDN e-Invoice Configuration
# Add these to your .env file

# E-Invoice API Configuration
EINVOICE_ENVIRONMENT=sandbox
EINVOICE_BASE_URL=https://api.myinvois.hasil.gov.my
EINVOICE_CLIENT_ID=your_client_id_here
EINVOICE_CLIENT_SECRET=your_client_secret_here

# Use official SDK (recommended) or custom service
EINVOICE_USE_SDK=true

# Default Supplier Information (Fallback when tenant info not available)
# Important: Each tenant should have their own TIN configured in the admin panel
EINVOICE_SUPPLIER_TIN=123456789012
EINVOICE_SUPPLIER_NAME=Your Company Name
EINVOICE_SUPPLIER_REGISTRATION_NUMBER=123456789012
EINVOICE_SUPPLIER_ADDRESS_1=Your Address Line 1
EINVOICE_SUPPLIER_ADDRESS_2=Your Address Line 2
EINVOICE_SUPPLIER_CITY=Kuala Lumpur
EINVOICE_SUPPLIER_STATE=Selangor
EINVOICE_SUPPLIER_POSTAL_CODE=50000
EINVOICE_SUPPLIER_COUNTRY=MY
EINVOICE_SUPPLIER_EMAIL=info@yourcompany.com
EINVOICE_SUPPLIER_PHONE=+60123456789
EINVOICE_SUPPLIER_BUSINESS_ACTIVITY_CODE=85100
EINVOICE_SUPPLIER_BUSINESS_ACTIVITY_DESCRIPTION=Child day-care activities

# MyInvois Client Configuration (should match EINVOICE_SUPPLIER_TIN)
EINVOICE_MYINVOIS_TIN=123456789012

# Default Consumer TIN (B2C)
# Used as fallback for individual consumers without TIN (NRIC-only buyers)
# LHDN requires TIN for all buyers, so this value is used when buyer lacks personal TIN
EINVOICE_DEFAULT_CONSUMER_TIN=EI00000000010

# For production, use:
# EINVOICE_ENVIRONMENT=production
# EINVOICE_BASE_URL=https://api.myinvois.hasil.gov.my
